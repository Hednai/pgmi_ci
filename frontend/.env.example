# URL de l'API. Laisser vide en développement : le proxy Vite s'en charge.
VITE_API_URL=

# Mode démonstration. À "true", les écrans sont alimentés par le jeu de
# données local (src/mocks) au lieu du backend. Sert aux présentations et au
# déploiement de la vitrine tant que l'API n'est pas en ligne.
VITE_MODE_DEMO=true
