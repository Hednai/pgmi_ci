# ============================================
# Variables d'environnement du backend PGMI
# Copier ce fichier en .env avant le premier démarrage.
# ============================================

NODE_ENV=development
PORT=4000

# Base de données.
# SQLite par défaut : aucune installation requise.
DATABASE_URL="file:./dev.db"
# PostgreSQL (Supabase / Neon / Render) : changer aussi le provider
# dans prisma/schema.prisma.
# DATABASE_URL="postgresql://user:password@host:5432/pgmi?schema=public"

# Origines autorisées par CORS, séparées par une virgule.
FRONTEND_URL="http://localhost:5173"

# URL publique de la page de vérification QR (imprimée sous le code).
PUBLIC_VERIFY_URL="http://localhost:4000/v"

# Secrets JWT. En production, générer des valeurs aléatoires distinctes
# d'au moins 32 caractères (openssl rand -base64 48).
JWT_ACCESS_SECRET="dev-access-secret-a-remplacer-32-caracteres-minimum"
JWT_REFRESH_SECRET="dev-refresh-secret-a-remplacer-32-caracteres-minimum"
# Clé de signature des QR codes (distincte des jetons de session).
QR_SIGNING_SECRET="dev-qr-secret-a-remplacer-32-caracteres-minimum"

# Fournisseurs externes. Laisser vide en développement :
# les implémentations console prennent le relais automatiquement.
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console
EMAIL_PROVIDER=console
PAYMENT_PROVIDER=sandbox
STORAGE_PROVIDER=local

AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
RESEND_API_KEY=

# Affiche le code OTP dans la réponse HTTP (développement uniquement).
EXPOSE_OTP_IN_RESPONSE=true
